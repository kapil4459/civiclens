# ---- Server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas connection string (required in production;
# dev falls back to in-memory MongoDB when absent)
MONGODB_URI=

# Google Gemini (Phase 4) - keep secret, backend only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Cloudinary (optional - local uploads fallback used when absent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
